{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Needle",
  "version": "2.0.1",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "channel-search-plus@johnkevin.dev",
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "src/core.js",
        "src/grid.js",
        "src/store.js",
        "src/library.js",
        "src/memory.js",
        "src/charts.js",
        "src/analysis.js",
        "src/niche.js",
        "src/panel.js",
        "src/omnibar.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "src/navigate.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Needle"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Y"
      },
      "description": "Open or close the Needle panel"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.youtube.com/*"
  ]
}
